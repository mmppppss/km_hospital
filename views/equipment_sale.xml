<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_product" model="ir.ui.view">
        <field name="name">product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="x_price"/>
            </list>
        </field>
    </record>

    <record id="view_base_product_form" model="ir.ui.view">
        <field name="name">product.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="x_price"/>
                        <field name='image_1920' widget='image' class='o_image_64_cover'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>